# PostgreSQL connection string. Required.
# Local example:   postgresql://postgres:password@localhost:5432/family_expenses
# Supabase example: postgresql://postgres:[password]@[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/family_expenses

# Only needed if you use the Supabase client SDK directly (not required by
# this project -- DATABASE_URL above is sufficient for a Supabase-hosted
# Postgres database too).
SUPABASE_URL=
SUPABASE_KEY=

# Anthropic API key, used only by chatbot.py (the local natural-language
# test harness) to turn free text into a tool call. Not needed to run the
# MCP server itself -- an MCP client like Claude supplies its own LLM.
LLM_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Port the FastMCP server listens on. Render/most PaaS providers set this
# automatically; override for local runs if 8000 is taken.
PORT=8000
